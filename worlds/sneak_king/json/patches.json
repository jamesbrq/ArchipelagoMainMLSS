  "patches": {
    "required": [
      {
        "name": "P2: Validator bypass (JZ to JMP)",
        "description": "Mission validator always takes available path, no prerequisites block playability",
        "va": "0x163CF",
        "old": "74",
        "new": "EB"
      },
      {
        "name": "P10: Bypass availability check in CacheLookup",
        "description": "CacheLookup at 0x61A20 checks the group availability bitfield at cache+0xA4 before reading rank data. Group 0 (Sawmill) was already bypassed via 'test ecx,ecx; je'. Changing JE to JMP makes ALL groups bypass this check, so rank data is always readable regardless of availability bits. Without this, GetMissionRank returns 1 (no data) for groups 1-3, breaking scroll rank textures and completion counting.",
        "va": "0x61A29",
        "old": "74",
        "new": "EB"
      },
      {
        "name": "P11: Disable vanilla level unlock in ScrollRebuild",
        "description": "ScrollRebuild's unlock loop at 0x157F0 checks if 10+ missions with rank>=C are completed in each level, then calls SetAvailability to unlock the next level. For AP, level unlocks are controlled by the client (via unlock items or x_missions threshold). Changing the JB to JMP makes the loop always skip SetAvailability calls, giving the client full control over which levels are available.",
        "va": "0x157F4",
        "old": "0f82d6000000",
        "new": "e9d700000090"
      },
      {
        "name": "P3: Hook UpdateMissionState",
        "description": "Replaces the is_active read with jmp to code cave. Gamestate check preserved so scrolls hide during active missions.",
        "va": "0x623B7",
        "old": "8b0dd82c2e0083b9ec00000001742689863901000084c0741c",
        "new": "8b0dd82c2e0083b9ec000000017426e975feffff9084c0741c"
      },
      {
        "name": "P5: Code cave — AP bitfield lookup (per-group padding)",
        "description": "Reads group from [esi+0x118] and slot from [esi+0x114], looks up AP visibility bit at cache + 0x38 + group*32 + slot/8, bit = slot%8. Each group's 3-byte AP field lives in the unused padding bytes of that group's 32-byte block in the MissionStateCache. This avoids writing to high offsets (+0xA8+) that caused controller corruption.",
        "va": "0x62240",
        "old": "51a1cc2c2e0085c0568bf1578bbe18010000c644240800752c68011000005068ecff2a0068d0000000e8b2c5000083c41085c074098bc8e8d4faffffeb0233c0a3cc2c2e000fb69614",
        "new": "8b861801000083f8037731c1e0050fb68e140100008bd183e207c1e9038d4408388b0dcc2c2e000fb604010fa3d00f92c0888639010000e9500100008a8639010000e945010000cccc"
      },
      {
        "name": "P8: NOP ActivateMission call in MissionIterationLoop",
        "description": "MissionIterationLoop calls 0x62240 after completion. Since that is now our code cave, NOP it.",
        "va": "0x1511B",
        "old": "e820d10000",
        "new": "9090909090"
      },
      {
        "name": "P9: Bypass prerequisite check in completion counter",
        "description": "isCompleted always counts missions based on own rank, no prerequisite chain required.",
        "va": "0x62340",
        "old": "74",
        "new": "EB"
      },
      {
        "name": "Function entry fix (push ecx)",
        "description": "Fixes function prologue at VA 0x17EE00",
        "va": "0x17EE00",
        "old": "CC",
        "new": "51"
      },
      {
        "name": "Height/Y-position fix",
        "description": "Corrects outlier Y-coordinate 100.0 to 3.7986 in position data table (.rdata)",
        "va": "0x2CA9B0",
        "old": "0000C842",
        "new": "1C1C7340"
      },
      {
        "name": "Force level load — mov eax,[global]",
        "description": "Replaces dynamic level pointer read with hardcoded global address.",
        "va": "0x13EF9",
        "old": "8B86980000008B4020",
        "new": "A1FC2F2E0090909090"
      },
      {
        "name": "Force level load — NOP cmovne",
        "description": "NOPs the conditional override so forced level is always used",
        "va": "0x13F04",
        "old": "0F45C1",
        "new": "909090"
      },
      {
        "name": "Level select — patchable starting level check",
        "description": "Replaces hardcoded if(index==0) with if(index==N) for starting level unlock.",
        "va": "0x619F6",
        "old": "85c97508b801000000c20400",
        "new": "83f900750731c040c2040090"
      },
      {
        "name": "Level select — mask out bit 0 in unlock checker",
        "description": "Changes and eax,0x0F to and eax,0x0E so Sawmill isn't always unlocked via bitfield.",
        "va": "0x61A13",
        "old": "0F",
        "new": "0E"
      }
